{
  "openapi": "3.0.3",
  "info": {
    "title": "FireControl 短信开放服务",
    "version": "1.0.0",
    "description": "账号密码换Token → 提交短信 → 按requestId查询。禁止未知结果自动换编号重发；submitted仅表示平台受理。"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "替换为实际部署API根地址"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/fire/sms/open/token": {
      "post": {
        "operationId": "getSmsToken",
        "summary": "短信专用账号登录；内部复用若依鉴权",
        "responses": {
          "200": {
            "description": "成功处理；发送仍需检查taskStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token失效或登录失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "账号角色/权限/来源限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "本账号未找到记录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "requestId内容冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "限频或额度不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "重试等待秒数",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "结果不可靠：保留编号先查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务或依赖未就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "security": []
      }
    },
    "/fire/sms/open/send": {
      "post": {
        "operationId": "sendSms",
        "summary": "持久化去重和预留额度后向平台发送",
        "responses": {
          "200": {
            "description": "成功处理；发送仍需检查taskStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token失效或登录失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "账号角色/权限/来源限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "本账号未找到记录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "requestId内容冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "限频或额度不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "重试等待秒数",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "结果不可靠：保留编号先查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务或依赖未就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Send"
              }
            }
          }
        }
      }
    },
    "/fire/sms/open/requests/{requestId}": {
      "get": {
        "operationId": "getSmsRequest",
        "summary": "只查询本账号的开放提交记录",
        "responses": {
          "200": {
            "description": "成功处理；发送仍需检查taskStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token失效或登录失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "账号角色/权限/来源限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "本账号未找到记录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "requestId内容冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "限频或额度不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "重试等待秒数",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "结果不可靠：保留编号先查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务或依赖未就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "同一发送意图沿用此编号；新发送生成新编号",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "",
            "minLength": 2,
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "description": "",
            "minLength": 5,
            "maxLength": 20,
            "writeOnly": true
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "token",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              200
            ]
          },
          "msg": {
            "type": "string",
            "description": ""
          },
          "token": {
            "type": "string",
            "description": ""
          },
          "tokenType": {
            "type": "string",
            "description": "",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "description": "秒；若依活跃会话可滑动续期，以401判断失效"
          }
        }
      },
      "Send": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "mobiles",
          "content"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "description": "同一发送意图沿用此编号；新发送生成新编号",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "mobiles": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "",
              "pattern": "^1[3-9][0-9]{9}$"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "content": {
            "type": "string",
            "description": "正文原文；不加签名、不编码，含签名默认总长1000 UTF-16字符",
            "minLength": 1,
            "maxLength": 4000
          },
          "bizId": {
            "type": "string",
            "description": "可选业务号，不用于去重",
            "maxLength": 100
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "recordId",
          "requestId",
          "recipientType",
          "mobiles",
          "content",
          "recipientName",
          "sourceName",
          "taskStatus",
          "deliveryStatus",
          "platformCode",
          "resultText",
          "platformTaskId",
          "acceptedPhones",
          "bizId",
          "createTime"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "description": "按字符串使用"
          },
          "requestId": {
            "type": "string",
            "description": "同一发送意图沿用此编号；新发送生成新编号",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "recipientType": {
            "type": "string",
            "description": "",
            "enum": [
              "external"
            ]
          },
          "mobiles": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "",
              "pattern": "^1[3-9][0-9]{9}$"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "content": {
            "type": "string",
            "description": "含服务端固定签名"
          },
          "recipientName": {
            "type": "string",
            "description": ""
          },
          "sourceName": {
            "type": "string",
            "description": ""
          },
          "taskStatus": {
            "type": "string",
            "description": "",
            "enum": [
              "submitted",
              "partial",
              "failed",
              "pending",
              "unknown"
            ]
          },
          "deliveryStatus": {
            "type": "string",
            "description": "",
            "enum": [
              "unconfirmed"
            ]
          },
          "platformCode": {
            "type": "string",
            "description": ""
          },
          "resultText": {
            "type": "string",
            "description": ""
          },
          "platformTaskId": {
            "type": "string",
            "description": ""
          },
          "acceptedPhones": {
            "type": "array",
            "items": {
              "type": "string",
              "description": ""
            }
          },
          "bizId": {
            "type": "string",
            "description": "",
            "maxLength": 100
          },
          "createTime": {
            "type": "string",
            "description": "数据库格式化时间 yyyy-MM-dd HH:mm:ss"
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              200
            ]
          },
          "msg": {
            "type": "string",
            "description": ""
          },
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "msg"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "msg": {
            "type": "string",
            "description": ""
          }
        }
      }
    }
  }
}
