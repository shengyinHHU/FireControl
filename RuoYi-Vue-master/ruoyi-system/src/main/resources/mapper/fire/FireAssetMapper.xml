<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.FireAssetMapper">
 <select id="lockGateway" resultType="map">SELECT gateway_id AS id,place_id AS placeId,source_address AS sourceAddress,center_address AS centerAddress,allowed_ip AS allowedIp,enabled,revision,del_flag AS delFlag FROM fire_gateway WHERE gateway_id=#{id} FOR UPDATE</select>
 <select id="lockHost" resultType="map">SELECT host_id AS id,gateway_id AS gatewayId,revision,del_flag AS delFlag FROM fire_host WHERE host_id=#{id} FOR UPDATE</select>
 <insert id="insertGateway" useGeneratedKeys="true" keyProperty="id">INSERT INTO fire_gateway(place_id,name,unit_name,device_code,manufacturer,model,source_address,center_address,allowed_ip,enabled,camera_ip,installation_status,remark,dept_id,supervisor_user_id,create_by) VALUES(#{a.placeId},#{a.name},#{a.unitName},#{a.deviceCode},#{a.manufacturer},#{a.model},#{a.sourceAddress},#{a.centerAddress},#{a.allowedIp},#{a.enabled},#{a.cameraIp},#{a.installationStatus},#{a.remark},#{deptId},#{userId},#{actor})</insert>
 <update id="updateGateway">UPDATE fire_gateway SET place_id=#{a.placeId},name=#{a.name},unit_name=#{a.unitName},device_code=#{a.deviceCode},manufacturer=#{a.manufacturer},model=#{a.model},source_address=#{a.sourceAddress},center_address=#{a.centerAddress},allowed_ip=#{a.allowedIp},enabled=#{a.enabled},camera_ip=#{a.cameraIp},installation_status=#{a.installationStatus},remark=#{a.remark},<if test="identityChanged">last_received_at=NULL,status_device_time=NULL,status_bits=NULL,status_description=NULL,</if>revision=revision+1,update_by=#{actor},update_time=NOW() WHERE gateway_id=#{a.id}</update>
 <insert id="insertHost" useGeneratedKeys="true" keyProperty="id">INSERT INTO fire_host(gateway_id,name,manufacturer,model,access_method,system_type,system_address,create_by) VALUES(#{a.gatewayId},#{a.name},#{a.manufacturer},#{a.model},#{a.accessMethod},#{a.systemType},#{a.systemAddress},#{actor})</insert>
 <update id="updateHost">UPDATE fire_host SET name=#{a.name},manufacturer=#{a.manufacturer},model=#{a.model},access_method=#{a.accessMethod},system_type=#{a.systemType},system_address=#{a.systemAddress},revision=revision+1,update_by=#{actor},update_time=NOW() WHERE host_id=#{a.id}</update>
 <update id="deleteGateway">UPDATE fire_gateway SET del_flag='2',enabled='1',revision=revision+1,update_by=#{actor},update_time=NOW() WHERE gateway_id=#{id}</update>
 <update id="deleteHost">UPDATE fire_host SET del_flag='2',revision=revision+1,update_by=#{actor},update_time=NOW() WHERE host_id=#{id}</update>
 <select id="unregistered" resultType="map">SELECT peer_ip AS allowedIp,SUBSTRING(raw_hex,25,12) AS sourceAddress,SUBSTRING(raw_hex,37,12) AS centerAddress,MAX(received_at) AS lastSeen,COUNT(*) AS receipts FROM fire_protocol_message WHERE gateway_id IS NULL AND parse_status='REJECTED' AND raw_hex LIKE '4040%' AND LENGTH(raw_hex)&gt;=60 GROUP BY peer_ip,SUBSTRING(raw_hex,25,12),SUBSTRING(raw_hex,37,12) ORDER BY MAX(received_at) DESC LIMIT 100</select>
</mapper>
