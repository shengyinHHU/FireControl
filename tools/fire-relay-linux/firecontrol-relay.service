[Unit]
Description=FireControl device relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=fire-relay
Group=fire-relay
WorkingDirectory=/opt/firecontrol-relay
ExecStart=/opt/firecontrol-relay/fire-relay --config /opt/firecontrol-relay/config.json
Restart=always
RestartSec=5
TimeoutStopSec=15
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
